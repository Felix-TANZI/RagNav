# backend/.env.example
# Copier en backend/.env (jamais versionné) et remplir les secrets. Ollama accepte toute clé non vide
# Sur GANDAL, LLM_BASE_URL vise LiteLLM (http://EMILIA:4000/v1) et LLM_API_KEY est la clé LiteLLM
# Utiliser 127.0.0.1 et non localhost (sous Windows, localhost tente IPv6 et ajoute 2 s par connexion)
# Dans un conteneur sur le PC, remplacer 127.0.0.1 par host.docker.internal
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:6333
CORS_ORIGINS=["http://localhost:5173"]
TESSDATA_PATH=
LIBREOFFICE_PATH=
