# backend/.env.example
# Copier en backend/.env (jamais versionné). Secrets à remplir, JWT_SECRET d'au moins 32 caractères aléatoires
# Sur GANDAL, LLM_BASE_URL vise LiteLLM (http://EMILIA:4000/v1) et LLM_API_KEY est la clé LiteLLM
# Utiliser 127.0.0.1 et non localhost (sous Windows, localhost tente IPv6 et ajoute 2 s par connexion)
LLM_API_KEY=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBED_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:6333
RETRIEVAL_MODE=hybride
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=true
REFRESH_COOKIE_PATH=/api/auth
ADMIN_NAME=Administrateur
MAX_UPLOAD_MB=50
EVENTS_RETENTION_DAYS=90
TESSDATA_PATH=
LIBREOFFICE_PATH=
